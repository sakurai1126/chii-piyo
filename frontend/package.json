    "clsx": "^2.1.1",
    "heic-to": "^1.6.7",
    "jose": "^6.2.18",
    "motion": "^13.5.1",
    "next": "^15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-remove-scroll": "^2.7.2",
    "recharts": "^3.11.2",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
