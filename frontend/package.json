{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-api": "rm -rf ./src/lib/api-client/gen/* && openapi-generator-cli generate -i ./openapi.yaml -g typescript-fetch -o ./src/lib/api-client/gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1124.0",
    "@tanstack/react-query": "^5.102.8",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "motion": "^13.1.1",
    "next": "^15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-remove-scroll": "^2.7.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
